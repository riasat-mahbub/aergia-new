# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Required in production. The expected hostname is the public application
# hostname registered for the Turnstile widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=register
TURNSTILE_VERIFICATION_TIMEOUT_SECONDS=3.0

# Development/test only. Never enable this in production.
# TURNSTILE_BYPASS=true

# Optional comma-separated IPs or CIDRs for the immediate trusted proxy peer.
# X-Forwarded-For is ignored when this is empty.
TRUSTED_PROXY_IPS=
# Keep this aligned with the Uvicorn proxy peers when forwarded scheme/host
# handling is needed. Never set it to '*'.
FORWARDED_ALLOW_IPS=
