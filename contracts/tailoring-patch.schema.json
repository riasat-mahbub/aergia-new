{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-patch.schema.json",
  "title": "Aergia tailoring patch protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "changes"],
  "properties": {
    "protocol_version": {"const": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "section_id", "entry_id", "value"],
            "properties": {
              "operation": {"const": "replace_description"},
              "section_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "entry_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "value": {"type": "string", "minLength": 1, "maxLength": 20000},
              "reason": {"type": ["string", "null"], "maxLength": 2000}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "requirement", "reason"],
            "properties": {
              "operation": {"const": "report_gap"},
              "requirement": {"type": "string", "minLength": 1, "maxLength": 500},
              "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        ]
      }
    }
  }
}
