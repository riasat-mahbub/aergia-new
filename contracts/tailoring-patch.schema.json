{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-patch.schema.json",
  "title": "Aergia tailoring patch protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "base_revision", "base_hash", "changes"],
  "properties": {
    "protocol_version": {"const": 1},
    "base_revision": {"type": "integer", "minimum": 1},
    "base_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/replaceDescription"},
          {"$ref": "#/$defs/rewriteRichText"},
          {"$ref": "#/$defs/removeBullet"},
          {"$ref": "#/$defs/reorderBullets"},
          {"$ref": "#/$defs/removeEntry"},
          {"$ref": "#/$defs/reorderEntries"},
          {"$ref": "#/$defs/addLibraryEntry"},
          {"$ref": "#/$defs/reportGap"}
        ],
        "discriminator": {"propertyName": "operation"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": ["string", "null"], "maxLength": 2000},
    "field": {"type": "string", "enum": ["description", "summary"]},
    "evidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "field_path", "section_id"],
          "properties": {
            "source": {"const": "cv"},
            "field_path": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},
            "section_id": {"$ref": "#/$defs/id"},
            "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
            "library_entry_id": {"type": "null"},
            "source_row_id": {"type": "null"},
            "source_hash": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "field_path", "library_entry_id", "source_row_id", "source_hash"],
          "properties": {
            "source": {"const": "library"},
            "field_path": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},
            "section_id": {"type": "null"},
            "entry_id": {"type": "null"},
            "library_entry_id": {"$ref": "#/$defs/id"},
            "source_row_id": {"$ref": "#/$defs/id"},
            "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "underline": {"type": "boolean"},
        "strike": {"type": "boolean"},
        "color": {"type": ["string", "null"]},
        "link": {"type": ["string", "null"]},
        "font_size": {"type": ["string", "null"], "enum": ["xs", "small", "normal", "large", "xl", null]}
      }
    },
    "richTextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "maxLength": 20000},
        "style": {"anyOf": [{"$ref": "#/$defs/textStyle"}, {"type": "null"}]}
      }
    },
    "richTextBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "items"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "enum": ["paragraph", "bullet_list", "numbered_list"]},
        "items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/richTextItem"}}
      }
    },
    "replaceDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "entry_id", "value"],
      "properties": {
        "operation": {"const": "replace_description"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"$ref": "#/$defs/id"},
        "value": {"type": "string", "minLength": 1, "maxLength": 20000},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "rewriteRichText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "field", "value", "evidence"],
      "properties": {
        "operation": {"const": "rewrite_rich_text"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field": {"$ref": "#/$defs/field"},
        "value": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/richTextBlock"}},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "removeBullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "field", "block_id", "item_id"],
      "properties": {
        "operation": {"const": "remove_bullet"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field": {"$ref": "#/$defs/field"},
        "block_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "reorderBullets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "field", "block_id", "item_ids"],
      "properties": {
        "operation": {"const": "reorder_bullets"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field": {"$ref": "#/$defs/field"},
        "block_id": {"$ref": "#/$defs/id"},
        "item_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "removeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "entry_id"],
      "properties": {
        "operation": {"const": "remove_entry"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"$ref": "#/$defs/id"},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "reorderEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "entry_ids"],
      "properties": {
        "operation": {"const": "reorder_entries"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "addLibraryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "library_entry_id", "source_row_id", "evidence"],
      "properties": {
        "operation": {"const": "add_library_entry"},
        "section_id": {"$ref": "#/$defs/id"},
        "library_entry_id": {"$ref": "#/$defs/id"},
        "source_row_id": {"$ref": "#/$defs/id"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "reportGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "requirement", "reason"],
      "properties": {
        "operation": {"const": "report_gap"},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 500},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
