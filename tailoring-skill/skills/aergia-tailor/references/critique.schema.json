{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-critique-v1.schema.json",
  "title": "Aergia internal tailoring critique v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_version",
    "candidate_hash",
    "pass_number",
    "seniority_assumption",
    "findings",
    "requirement_review"
  ],
  "properties": {
    "rubric_version": {"const": "aergia-critique-v1"},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pass_number": {"type": "integer", "minimum": 1, "maximum": 5},
    "seniority_assumption": {"type": "string", "minLength": 1, "maxLength": 200},
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "section_id", "excerpt", "problem", "recommended_change"],
        "properties": {
          "category": {"enum": ["job_alignment", "evidence_credibility", "impact", "clarity", "rendered_presentation"]},
          "severity": {"enum": ["critical", "important", "polish"]},
          "section_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "field_path": {"type": "string", "minLength": 1, "maxLength": 128},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 2000},
          "problem": {"type": "string", "minLength": 1, "maxLength": 1000},
          "recommended_change": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "requirement_review": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "evidence", "rationale"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"enum": ["present", "supported_but_missing", "reasonably_inferred", "unsupported"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 1000},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
