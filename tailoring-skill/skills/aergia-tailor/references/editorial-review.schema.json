{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-editorial-review-v1.schema.json",
  "title": "Aergia unscored tailoring editorial review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_version", "candidate_hash", "pass_number", "findings", "inference_notes"],
  "properties": {
    "review_version": {"const": "aergia-editorial-review-v1"},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pass_number": {"type": "integer", "minimum": 1, "maximum": 5},
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "section_id", "excerpt", "problem", "recommended_change"],
        "properties": {
          "category": {"enum": ["evidence_selection", "framing", "impact", "clarity", "natural_writing", "visual_balance"]},
          "severity": {"enum": ["important", "polish", "blocking"]},
          "section_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "field_path": {"type": "string", "minLength": 1, "maxLength": 256},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 2000},
          "problem": {"type": "string", "minLength": 1, "maxLength": 1000},
          "recommended_change": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "inference_notes": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/inference_note"}
    }
  },
  "$defs": {
    "inference_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "basis", "confidence", "review_recommended"],
      "properties": {
        "claim": {"type": "string", "minLength": 1, "maxLength": 500},
        "basis": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "confidence": {"enum": ["entailed", "strong", "reasonable", "speculative"]},
        "section_id": {"type": "string", "maxLength": 128},
        "item_id": {"type": "string", "maxLength": 128},
        "field_path": {"type": "string", "maxLength": 256},
        "review_recommended": {"type": "boolean"}
      }
    }
  }
}
