{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-editorial-review-v2.schema.json",
  "title": "Aergia unscored tailoring editorial review v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_version", "evaluation_id", "candidate_hash", "findings"],
  "properties": {
    "review_version": {"const": "aergia-editorial-review-v2"},
    "evaluation_id": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "section_id", "excerpt", "problem", "recommended_change"],
        "properties": {
          "category": {"enum": ["evidence_selection", "targeting", "framing", "impact", "clarity", "natural_writing", "visual_balance"]},
          "severity": {"enum": ["important", "polish", "blocking"]},
          "section_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "field_path": {"type": "string", "minLength": 1, "maxLength": 256},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 2000},
          "problem": {"type": "string", "minLength": 1, "maxLength": 1000},
          "recommended_change": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
