{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-patch.schema.json",
  "title": "Aergia tailoring patch protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "base_revision", "base_hash", "changes"],
  "properties": {
    "protocol_version": {"const": 1},
    "base_revision": {"type": "integer", "minimum": 1},
    "base_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilities_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "ai_relevance": {"anyOf": [{"$ref": "#/$defs/aiRelevanceAssessment"}, {"type": "null"}]},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/replaceDescription"},
          {"$ref": "#/$defs/replaceRichText"},
          {"$ref": "#/$defs/rewriteRichText"},
          {"$ref": "#/$defs/removeBullet"},
          {"$ref": "#/$defs/reorderBullets"},
          {"$ref": "#/$defs/removeEntry"},
          {"$ref": "#/$defs/reorderEntries"},
          {"$ref": "#/$defs/addLibraryEntry"},
          {"$ref": "#/$defs/createSection"},
          {"$ref": "#/$defs/replaceSection"},
          {"$ref": "#/$defs/removeSection"},
          {"$ref": "#/$defs/reorderSections"},
          {"$ref": "#/$defs/replaceCandidate"},
          {"$ref": "#/$defs/reportGap"}
        ],
        "discriminator": {"propertyName": "operation"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": ["string", "null"], "maxLength": 2000},
    "field": {"type": "string", "enum": ["description", "summary"]},
    "evidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "field_path", "section_id"],
          "properties": {
            "source": {"const": "cv"},
            "field_path": {"type": "string", "pattern": "^(?:\\*|[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)$"},
            "section_id": {"$ref": "#/$defs/id"},
            "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
            "library_entry_id": {"type": "null"},
            "source_row_id": {"type": "null"},
            "source_hash": {"type": "null"},
            "url": {"type": "null"},
            "title": {"type": "null"},
            "excerpt": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "field_path", "library_entry_id", "source_row_id", "source_hash"],
          "properties": {
            "source": {"const": "library"},
            "field_path": {"type": "string", "pattern": "^(?:\\*|[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)$"},
            "section_id": {"type": "null"},
            "entry_id": {"type": "null"},
            "library_entry_id": {"$ref": "#/$defs/id"},
            "source_row_id": {"$ref": "#/$defs/id"},
            "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "url": {"type": "null"},
            "title": {"type": "null"},
            "excerpt": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "url", "title", "excerpt"],
          "properties": {
            "source": {"const": "web"},
            "field_path": {"type": "null"},
            "section_id": {"type": "null"},
            "entry_id": {"type": "null"},
            "library_entry_id": {"type": "null"},
            "source_row_id": {"type": "null"},
            "source_hash": {"type": "null"},
            "url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://"},
            "title": {"type": "string", "minLength": 1, "maxLength": 255},
            "excerpt": {"type": "string", "minLength": 1, "maxLength": 4000}
          }
        }
      ]
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "underline": {"type": "boolean"},
        "strike": {"type": "boolean"},
        "color": {"type": ["string", "null"]},
        "link": {"type": ["string", "null"]},
        "font_size": {"type": ["string", "null"], "enum": ["xs", "small", "normal", "large", "xl", null]}
      }
    },
    "sectionStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {"$ref": "#/$defs/textStyle"}
        },
        "subsection": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "text_align": {"type": ["string", "null"], "enum": ["left", "right", "center", "justify", null]},
            "spacing_before": {"type": ["string", "null"]},
            "spacing_after": {"type": ["string", "null"]},
            "entry_gap": {"type": ["string", "null"]},
            "field_gap": {"type": ["string", "null"]},
            "background_color": {"type": ["string", "null"]},
            "section_color": {"type": ["string", "null"]},
            "accent_color": {"type": ["string", "null"]}
          }
        },
        "layout": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "font_family": {"type": ["string", "null"]},
            "date_style": {"type": ["object", "null"]},
            "break_before": {"type": "boolean"},
            "keep_together": {"type": "boolean"},
            "heading_keeps_with_first": {"type": "boolean"},
            "orphans": {"type": "integer"},
            "widows": {"type": "integer"},
            "chip_keys": {"type": ["array", "null"], "maxItems": 32, "items": {"type": "string"}}
          }
        },
        "typography": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "heading": {"$ref": "#/$defs/typographyRole"},
            "body": {"$ref": "#/$defs/typographyRole"}
          }
        },
        "policy": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "show_title": {"type": "boolean"},
            "heading_divider": {"type": "boolean"},
            "skill_variant": {"type": ["string", "null"], "enum": ["block", "inline", null]},
            "entry_layout": {"type": "string", "enum": ["stack", "two-column"]}
          }
        }
      }
    },
    "typographyRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font_family": {"type": ["string", "null"]},
        "font_size": {"type": ["string", "null"], "enum": ["xs", "small", "normal", "large", "xl", null]},
        "line_height": {"type": ["string", "null"], "enum": ["tight", "normal", "relaxed", null]},
        "color": {"type": ["string", "null"]},
        "bold": {"type": ["boolean", "null"]}
      }
    },
    "richTextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "maxLength": 20000},
        "style": {"anyOf": [{"$ref": "#/$defs/textStyle"}, {"type": "null"}]}
      }
    },
    "richTextBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "items"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "enum": ["paragraph", "bullet_list", "numbered_list"]},
        "items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/richTextItem"}}
      }
    },
    "replaceDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "entry_id", "value"],
      "properties": {
        "operation": {"const": "replace_description"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"$ref": "#/$defs/id"},
        "value": {"type": "string", "minLength": 1, "maxLength": 20000},
        "reason": {"$ref": "#/$defs/reason"},
        "evidence": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "rewriteRichText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "field", "value", "evidence"],
      "properties": {
        "operation": {"const": "rewrite_rich_text"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field": {"$ref": "#/$defs/field"},
        "value": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/richTextBlock"}},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "replaceRichText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "field", "value"],
      "properties": {
        "operation": {"const": "replace_rich_text"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field": {"$ref": "#/$defs/field"},
        "value": {"type": "string", "minLength": 1, "maxLength": 20000},
        "evidence": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "removeBullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "field", "block_id", "item_id"],
      "properties": {
        "operation": {"const": "remove_bullet"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field": {"$ref": "#/$defs/field"},
        "block_id": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "reorderBullets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "field", "block_id", "item_ids"],
      "properties": {
        "operation": {"const": "reorder_bullets"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field": {"$ref": "#/$defs/field"},
        "block_id": {"$ref": "#/$defs/id"},
        "item_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "removeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "entry_id"],
      "properties": {
        "operation": {"const": "remove_entry"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"$ref": "#/$defs/id"},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "reorderEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "entry_ids"],
      "properties": {
        "operation": {"const": "reorder_entries"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "addLibraryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "library_entry_id", "source_row_id", "evidence"],
      "properties": {
        "operation": {"const": "add_library_entry"},
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "library_entry_id": {"$ref": "#/$defs/id"},
        "source_row_id": {"$ref": "#/$defs/id"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "tailoringSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "enabled": {"type": "boolean"},
        "data": {"type": ["array", "object"], "maxItems": 100, "maxProperties": 100},
        "style": {"anyOf": [{"$ref": "#/$defs/sectionStyle"}, {"type": "null"}]}
      }
    },
    "createSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section", "reason", "evidence"],
      "properties": {
        "operation": {"const": "create_section"},
        "section": {"$ref": "#/$defs/tailoringSection"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "replaceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "section", "reason", "evidence"],
      "properties": {
        "operation": {"const": "replace_section"},
        "section_id": {"$ref": "#/$defs/id"},
        "section": {"$ref": "#/$defs/tailoringSection"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "removeSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_id", "reason", "evidence"],
      "properties": {
        "operation": {"const": "remove_section"},
        "section_id": {"$ref": "#/$defs/id"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "reorderSections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "section_ids", "reason", "evidence"],
      "properties": {
        "operation": {"const": "reorder_sections"},
        "section_ids": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "candidateCv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sections"],
      "properties": {
        "id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "description": {"type": ["string", "null"], "maxLength": 500},
        "template_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "sections": {
          "oneOf": [
            {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/tailoringSection"}},
            {"type": "object", "maxProperties": 32}
          ]
        },
        "customizations": {"type": "object", "maxProperties": 100}
      }
    },
    "replaceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "candidate", "evidence"],
      "properties": {
        "operation": {"const": "replace_candidate"},
        "candidate": {"$ref": "#/$defs/candidateCv"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "aiEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "field_path", "excerpt"],
      "properties": {
        "section_id": {"$ref": "#/$defs/id"},
        "entry_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "field_path": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?:\\*|[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)$"},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "aiRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "coverage", "score", "confidence", "rationale"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/id"},
        "coverage": {"type": "string", "enum": ["absent", "weak", "partial", "strong", "excellent"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/aiEvidence"}},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "aiRelevanceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_version", "requirements"],
      "properties": {
        "rubric_version": {"const": "ai-relevance-v1"},
        "requirements": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/aiRequirement"}},
        "evaluation_mode": {"type": "string", "enum": ["independent_pass", "same_agent_pass"]},
        "evaluator": {"type": ["string", "null"], "maxLength": 128},
        "claimed_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}
      }
    },
    "reportGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "requirement", "reason"],
      "properties": {
        "operation": {"const": "report_gap"},
        "requirement_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "requirement": {"type": "string", "minLength": 1, "maxLength": 500},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
