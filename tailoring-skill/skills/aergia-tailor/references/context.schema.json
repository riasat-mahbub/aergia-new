{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-context-v5.schema.json",
  "title": "Aergia tailoring context protocol v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "session_id", "application_id", "context_hash", "job", "profile", "library", "scanner", "requirements", "templates", "selected_template_id", "selected_template_manifest", "capabilities", "capabilities_hash", "evaluation_version"],
  "properties": {
    "protocol_version": {"const": 5},
    "session_id": {"type": "string"},
    "application_id": {"type": "string"},
    "source_cv_id": {"type": ["string", "null"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job": {
      "type": "object",
      "required": ["company", "role", "description", "user_instructions"],
      "properties": {
        "company": {"type": "string"},
        "role": {"type": "string"},
        "job_url": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "user_instructions": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "profile": {"type": "object"},
    "previous_cv": {"type": ["object", "null"]},
    "library": {"type": "array"},
    "scanner": {
      "type": "object",
      "required": ["schema_version", "versions", "requirement_extraction", "source_scan"],
      "properties": {
        "schema_version": {"const": "scanner-v1"},
        "versions": {"type": "object"},
        "requirement_extraction": {"type": "object"},
        "source_scan": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "requirements": {"type": "array"},
    "templates": {"type": "array"},
    "selected_template_id": {"type": "string"},
    "selected_template_manifest": {"type": "object"},
    "capabilities": {"type": "object"},
    "capabilities_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_appearance": {"type": "object"},
    "rendered_source": {"type": ["object", "null"]},
    "evaluation_version": {"const": "tailoring-evaluation-v1"}
  }
}
