{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aergia.local/contracts/tailoring-context-v8.schema.json",
  "title": "Aergia tailoring composition context protocol v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "session_id", "application_id", "expires_at", "context_hash", "job", "profile", "scanner", "requirements", "templates", "selected_template_id", "selected_template_manifest", "capabilities", "capabilities_hash", "candidate_index", "candidate_evidence", "writer_context_characters", "evaluation_version"],
  "properties": {
    "protocol_version": {"const": 8},
    "session_id": {"type": "string"},
    "application_id": {"type": "string"},
    "source_cv_id": {"type": ["string", "null"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job": {"type": "object"},
    "profile": {"type": "object"},
    "previous_cv": {"type": ["object", "null"]},
    "scanner": {"type": "object"},
    "requirements": {"type": "array"},
    "templates": {"type": "array"},
    "selected_template_id": {"type": "string"},
    "selected_template_manifest": {"type": "object"},
    "capabilities": {"type": "object"},
    "capabilities_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_index": {"type": "object"},
    "candidate_evidence": {"type": "object"},
    "linked_cv_scan": {"type": ["object", "null"]},
    "opportunities": {"type": "array"},
    "retrieved_sources": {"type": "array"},
    "writer_context_characters": {"type": "integer", "minimum": 0},
    "effective_appearance": {"type": "object"},
    "rendered_source": {"type": ["object", "null"]},
    "evaluation_version": {"const": "tailoring-evaluation-v2"}
  }
}
