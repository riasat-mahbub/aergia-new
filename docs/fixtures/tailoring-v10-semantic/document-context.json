      "customizations": {
        "$defs": {
          "CVLayout": {
            "additionalProperties": false,
            "description": "Per-CV zone layout written by the editor's layout authoring.\n\nCarries the same shape as the manifest's zones/placement but is a per-CV\noverride: the resolver renders these zones when present, falling back to\nthe template manifest. ``placement`` is always keyed by section instance\nid. Template manifests retain their separate type-keyed placement map.",
            "properties": {
              "zones": {
                "items": {
                  "$ref": "#/$defs/Zone"
                },
                "maxItems": 8,
                "title": "Zones",
                "type": "array"
              },
              "placement": {
                "additionalProperties": {
                  "type": "string"
                },
                "maxProperties": 64,
                "title": "Placement",
                "type": "object"
              }
            },
            "title": "CVLayout",
            "type": "object"
          },
          "Zone": {
            "additionalProperties": false,
            "description": "One zone in the template layout.",
            "properties": {
              "id": {
                "maxLength": 64,
                "title": "Id",
                "type": "string"
              },
              "label": {
                "anyOf": [
                  {
                    "maxLength": 255,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Label"
              },
              "styles": {
                "$ref": "#/$defs/ZoneStyle"
              }
            },
            "required": [
              "id"
            ],
            "title": "Zone",
            "type": "object"
          },
          "ZoneStyle": {
            "additionalProperties": false,
            "description": "Constrained style for a zone.\n\nThe manifest exposes a closed vocabulary: ``width`` is a\n:data:`WidthToken`, ``background`` is a color ref (a hex literal or\na palette reference), and ``padding`` is a :data:`PaddingToken`.\nThe manifest never carries raw CSS strings; the resolver maps each\ntoken to the renderer's native value.\n\nThe schema is closed (``extra=\"forbid\"``) so a manifest cannot smuggle\nin raw CSS like ``display: flex`` or ``position: absolute``. The\nrenderer's vocabulary is the only vocabulary.",
            "properties": {
              "width": {
                "anyOf": [
                  {
                    "enum": [
                      "narrow",
                      "half",
                      "full",
                      "auto"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Width"
              },
              "background": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Background"
              },
              "padding": {
                "anyOf": [
                  {
                    "enum": [
                      "none",
                      "tight",
                      "comfortable",
                      "loose",
                      "spacious"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Padding"
              }
            },
            "title": "ZoneStyle",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "User-level overrides on the cascade (canonical v2 shape).\n\nDocument-wide appearance and layout values are written by the per-CV\ncustomization editor. Section-local style belongs only on\n``SectionInstance.style``. ``accent_color`` is a color ref (hex literal\nor palette reference). The model is closed.",
        "properties": {
          "accent_color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Accent Color"
          },
          "body_font": {
            "anyOf": [
              {
                "enum": [
                  "sans-serif",
                  "serif",
                  "mono",
                  "display"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Body Font"
          },
          "heading_font": {
            "anyOf": [
              {
                "enum": [
                  "sans-serif",
                  "serif",
                  "mono",
                  "display"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Heading Font"
          },
          "default_text_align": {
            "anyOf": [
              {
                "enum": [
                  "left",
                  "right",
                  "center",
                  "justify"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Default Text Align"
          },
          "spacing": {
            "anyOf": [
              {
                "enum": [
                  "none",
                  "compact",
                  "comfortable",
                  "minimal"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Spacing"
          },
          "flags": {
            "additionalProperties": {
              "type": "boolean"
            },
            "maxProperties": 32,
            "title": "Flags",
            "type": "object"
          },
          "layout": {
            "anyOf": [
              {
                "$ref": "#/$defs/CVLayout"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "title": "Customizations",
        "type": "object"
      },
