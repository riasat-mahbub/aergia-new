      "wire_schema": {
        "$defs": {
          "DateStyle": {
            "additionalProperties": false,
            "description": "Per-section date display format.\n\nMirrors the TypeScript ``DateStyle`` in ``web/src/generated/schema.ts``\nand the ``DATE_STYLE_OPTIONS`` presets in\n``app/services/renderer/builders/_utils.py``. The ``key`` selects the\nformat; ``range_sep`` is the separator between the start and end bound.",
            "properties": {
              "key": {
                "default": "Month YYYY",
                "maxLength": 32,
                "title": "Key",
                "type": "string"
              },
              "rangeSep": {
                "default": " \u2013 ",
                "maxLength": 16,
                "title": "Rangesep",
                "type": "string"
              }
            },
            "title": "DateStyle",
            "type": "object"
          },
          "LayoutHints": {
            "additionalProperties": false,
            "description": "Page flow and structural intent. The renderer emits these as CSS.\n\n``orphans``/``widows`` map to the CSS ``orphans``/``widows`` properties\non the section wrapper; Chromium honours them on ``@page`` flow but is\nbest-effort elsewhere. ``keep_together`` maps to ``break-inside: avoid``\napplied per entry (each ``<div class=\"entry\">`` is the unit that must\nnot split across pages), so an overflowing entry moves to the next\npage on its own instead of dragging the whole section with it. Entries\nlarger than a page split anyway \u2014 Chromium's ``break-inside: avoid``\nis best-effort.",
            "properties": {
              "font_family": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Font Family"
              },
              "date_style": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/DateStyle"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "break_before": {
                "default": false,
                "title": "Break Before",
                "type": "boolean"
              },
              "keep_together": {
                "default": true,
                "title": "Keep Together",
                "type": "boolean"
              },
              "heading_keeps_with_first": {
                "default": true,
                "title": "Heading Keeps With First",
                "type": "boolean"
              },
              "orphans": {
                "default": 2,
                "title": "Orphans",
                "type": "integer"
              },
              "widows": {
                "default": 2,
                "title": "Widows",
                "type": "integer"
              },
              "chip_keys": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 32,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Chip Keys"
              }
            },
            "title": "LayoutHints",
            "type": "object"
          },
          "SectionInstanceStyle": {
            "additionalProperties": false,
